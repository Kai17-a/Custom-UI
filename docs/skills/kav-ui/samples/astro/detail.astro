---
import {
  KavBadge,
  KavButton,
  KavDialog,
  KavPage,
  KavPageHeader,
  KavProvider,
} from "@kav-ui/astro";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>秋の展示会 / Astro</title>
  </head>
  <body>
    <KavProvider />
    <main class="ui-container">
      <KavPage>
        <nav aria-label="パンくず">
          <ol class="breadcrumb breadcrumb-chevron">
            <li><a href="../list/">プロジェクト一覧</a></li>
            <li aria-current="page">秋の展示会</li>
          </ol>
        </nav>
        <KavPageHeader
          eyebrow="木の葉制作室"
          title="秋の展示会"
          description="作品と制作の背景を紹介する、チームの共同プロジェクトです。"
        >
          <Fragment slot="actions">
            <KavButton
              type="button"
              data-ui-toggle="dialog"
              data-ui-target="#share-dialog"
              color="primary"
              variant="outline"
            >共有情報</KavButton>
          </Fragment>
        </KavPageHeader>

        <KavPage railLabel="プロジェクトの補足">
          <!-- 通常HTMLのタブをProviderのランタイムで初期化します。 -->
          <div data-ui-tabs data-kav-ui-widget>
            <div class="tabs" role="tablist" aria-label="プロジェクトの詳細">
              <button
                type="button"
                data-ui-toggle="tab"
                data-ui-target="overview"
                aria-selected="true"
              >概要</button>
              <button
                type="button"
                data-ui-toggle="tab"
                data-ui-target="history"
              >履歴</button>
            </div>
            <section class="tab-panel ui-stack" data-ui-panel="overview">
              <div class="ui-section">
                <h2>開催概要</h2>
                <p>11月の展示に向けて、作品の選定と会場の準備を進めています。</p>
              </div>
              <div class="ui-section">
                <h3>次の作業</h3>
                <p>展示作品の候補を11月10日までに集めます。</p>
              </div>
            </section>
            <section class="tab-panel ui-stack" data-ui-panel="history" hidden>
              <div class="ui-section">
                <h2>更新履歴</h2>
                <p>
                <time datetime="2026-11-02">11月2日</time>：展示のテーマを決めました。</p>
              </div>
            </section>
          </div>
          <div slot="rail">
            <h2 class="ui-aside-title">担当と期限</h2>
            <dl>
              <dt>担当</dt>
              <dd class="sp-m-0">制作チーム</dd>
              <dt>期限</dt>
              <dd class="sp-m-0">
                <time datetime="2026-11-20">2026年11月20日</time>
              </dd>
            </dl>
            <div class="ui-cluster"><KavBadge color="success">進行中</KavBadge></div>
          </div>
        </KavPage>

        <KavDialog id="share-dialog" label="共有情報">
          <h2>共有する前に</h2>
          <p>この画面はチーム内限定です。共有URLの発行と権限設定はアプリ側で接続してください。</p>
          <KavButton type="button" data-ui-dismiss="dialog" color="primary">閉じる</KavButton>
        </KavDialog>
      </KavPage>
    </main>
  </body>
</html>
<script>
  document.querySelectorAll<HTMLFormElement>("main form").forEach((form) => {
    form.addEventListener("submit", (event) => event.preventDefault());
  });
</script>
