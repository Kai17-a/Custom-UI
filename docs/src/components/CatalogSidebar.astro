---
interface Props {
  page: string;
  component: boolean;
}
const { page, component } = Astro.props;
const rootPrefix = component ? '../' : '';
const componentPrefix = component ? '' : 'components/';
const overviewCurrent = (file: string) => !component && page === file ? 'page' : undefined;
const componentCurrent = (file: string) => component && page === file ? 'page' : undefined;
