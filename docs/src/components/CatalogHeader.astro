---
const { prefix, wideThemeSelect } = Astro.props;
---
<header class="catalog-header"><a class="brand" href={prefix + 'index.html'}>Kav-UI <span>design catalog</span></a>
<div class="catalog-toolbar">
<label class="catalog-theme-control"><span>デザイン</span>
<select class:list={['form-select form-select-sm', { 'ui-w-auto': wideThemeSelect }]} data-ui-theme-select><option value="default">標準</option><option value="glass">ガラス</option><option value="glassmorphism">グラスモーフィズム</option><option value="flat">フラット</option><option value="soft">ソフト</option>
</select>
</label>
<label class="catalog-theme-control"><span>配色</span>
<select class="form-select form-select-sm" data-ui-palette-select><option value="default">標準</option><option value="slate">スレート</option><option value="sage">セージ</option><option value="teal">ティール</option><option value="mauve">モーブ</option><option value="sand">サンド</option><option value="clay">クレイ</option>
</select>
</label>
<button type="button" class="btn btn-sm btn-outline-secondary btn-icon-only" data-ui-toggle="theme" data-ui-theme-icon icon="mdi-weather-night" aria-label="ダークに切替" title="ダークに切替"></button>
</div></header>
