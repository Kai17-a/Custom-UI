---
import {
  KavButton,
  KavCard,
  KavGrid,
  KavPage,
  KavPageHeader,
  KavProvider,
  KavStack,
} from "@kav-ui/astro";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>チームに合うプラン / Astro</title>
  </head>
  <body>
    <KavProvider />
    <main class="ui-container">
      <KavPage>
        <KavPageHeader
          eyebrow="木の葉制作室"
          title="チームに合うプラン"
          description="月額料金は税込の架空の例です。契約と決済はアプリ側で接続します。"
        />
        <p>全プランにメールサポートが含まれます。</p>
        <KavGrid cols="auto">
          <KavCard>
            <KavStack>
              <h2 class="ui-card-title">個人</h2>
              <p class="ui-card-stat">
                ¥0<small>/ 月</small>
              </p>
              <ul>
                <li>メンバー1名</li>
                <li>容量1GB</li>
              </ul>
              <KavButton href="../auth/" color="primary" variant="outline">個人で登録へ進む</KavButton>
            </KavStack>
          </KavCard>
          <KavCard class="ui-card-selected">
            <KavStack>
              <div class="ui-cluster"><h2 class="ui-card-title">制作チーム</h2><span class="badge text-bg-success">おすすめ</span></div>
              <p class="ui-card-stat">
                ¥1,800<small>/ 月</small>
              </p>
              <ul>
                <li>メンバー10名</li>
                <li>容量50GB</li>
              </ul>
              <KavButton href="../auth/" color="primary">制作チームで登録へ進む</KavButton>
            </KavStack>
          </KavCard>
          <KavCard>
            <KavStack>
              <h2 class="ui-card-title">制作室</h2>
              <p class="ui-card-stat">
                ¥4,800<small>/ 月</small>
              </p>
              <ul>
                <li>メンバー30名</li>
                <li>容量200GB</li>
              </ul>
              <KavButton href="../auth/" color="primary" variant="outline">制作室で登録へ進む</KavButton>
            </KavStack>
          </KavCard>
        </KavGrid>
      </KavPage>
    </main>
  </body>
</html>
<script>
  document.querySelectorAll<HTMLFormElement>("main form").forEach((form) => {
    form.addEventListener("submit", (event) => event.preventDefault());
  });
</script>
