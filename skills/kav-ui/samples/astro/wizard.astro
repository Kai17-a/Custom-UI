---
import {KavButton, KavField, KavInput, KavPage, KavPageHeader, KavProvider} from '@kav-ui/astro';
---
<!doctype html>
<html lang="ja"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>制作依頼を作成 / Astro</title></head>
<body><KavProvider /><main class="ui-container" data-screen-sample data-kav-ui-widget>
<KavPage>
<KavPageHeader eyebrow="木の葉制作室" title="制作依頼を作成" description="入力・予定・確認の順に進めます。タブは矢印キーでも移動できます。" />

<form id="request-form" class="ui-stack"><div data-ui-tabs><div class="tabs" role="tablist" aria-label="依頼の手順"><button type="button" data-ui-toggle="tab" data-ui-target="request-input" aria-selected="true">1. 基本情報</button>
<button type="button" data-ui-toggle="tab" data-ui-target="request-schedule">2. 予定</button>
<button type="button" data-ui-toggle="tab" data-ui-target="request-confirm">3. 確認</button>
</div>
<section class="tab-panel ui-stack" data-ui-panel="request-input"><h2>基本情報</h2>
<KavField label="依頼名" for="request-title"><KavInput id="request-title" name="request-title" type="text" value="展示会の案内状" required maxlength="80" /></KavField>
</section>
<section class="tab-panel ui-stack" data-ui-panel="request-schedule" hidden><h2>予定</h2>
<KavField label="希望日" for="request-date"><KavInput id="request-date" name="request-date" type="date" value="2026-11-20" required /></KavField>
</section>
<section class="tab-panel ui-stack" data-ui-panel="request-confirm" hidden><h2>入力内容の確認</h2>
<dl><dt>依頼名</dt>
<dd><output id="confirm-title" for="request-title">展示会の案内状</output>
</dd>
<dt>希望日</dt>
<dd><output id="confirm-date" for="request-date">2026-11-20</output>
</dd>
</dl>
<p>修正する場合は前のタブへ戻ってください。送信処理はアプリ側で接続します。</p>
<KavButton type="submit" color="primary">この内容で依頼する</KavButton>
</section>
</div>
</form>


</KavPage>

</main></body></html>
<script>
document.querySelectorAll<HTMLFormElement>('[data-screen-sample] form').forEach(form => {
  form.addEventListener('submit', event => event.preventDefault());
});
</script>
<script>
const form = document.querySelector<HTMLFormElement>('#request-form')!;
const title = form.querySelector<HTMLInputElement>('#request-title')!;
const date = form.querySelector<HTMLInputElement>('#request-date')!;
const sync = () => {
  document.querySelector<HTMLOutputElement>('#confirm-title')!.value = title.value;
  document.querySelector<HTMLOutputElement>('#confirm-date')!.value = date.value;
};
form.addEventListener('input', sync);
// 非表示タブ内の必須入力にもブラウザの検証結果を表示します。
form.addEventListener('invalid', event => {
  const panel = (event.target as HTMLElement).closest<HTMLElement>('[data-ui-panel]');
  form.querySelector<HTMLButtonElement>('[data-ui-target="' + panel?.dataset.uiPanel + '"]')?.click();
}, true);
sync();
</script>
