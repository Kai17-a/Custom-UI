---
import {
  KavButton,
  KavField,
  KavInput,
  KavPage,
  KavPageHeader,
  KavProvider,
} from "@kav-ui/astro";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>チームへようこそ / Astro</title>
  </head>
  <body>
    <KavProvider />
    <main class="ui-container">
      <KavPage>
        <KavPageHeader
          eyebrow="木の葉制作室"
          title="チームへようこそ"
          description="木の葉制作室の作業スペースにアクセスします。"
        />
        <!-- 通常HTMLのタブをProviderのランタイムで初期化します。 -->
        <div data-ui-tabs data-kav-ui-widget>
          <div class="tabs" role="tablist" aria-label="アカウント">
            <button
              type="button"
              data-ui-toggle="tab"
              data-ui-target="signin"
              aria-selected="true"
            >ログイン</button>
            <button type="button" data-ui-toggle="tab" data-ui-target="signup">新規登録</button>
          </div>
          <section class="tab-panel ui-stack" data-ui-panel="signin">
            <h2>ログイン</h2>
            <form class="ui-stack">
              <KavField label="メールアドレス" for="login-email">
                <KavInput
                  id="login-email"
                  name="login-email"
                  type="email"
                  value=""
                  required
                  autocomplete="username"
                />
              </KavField>
              <KavField label="パスワード" for="login-password">
                <KavInput
                  id="login-password"
                  name="login-password"
                  type="password"
                  value=""
                  required
                  autocomplete="current-password"
                />
              </KavField>
              <KavButton type="submit" color="primary">ログイン</KavButton>
            </form>
          </section>
          <section class="tab-panel ui-stack" data-ui-panel="signup" hidden>
            <h2>新規登録</h2>
            <form class="ui-stack">
              <KavField label="表示名" for="signup-name">
                <KavInput
                  id="signup-name"
                  name="signup-name"
                  type="text"
                  value=""
                  required
                  autocomplete="nickname"
                />
              </KavField>
              <KavField label="メールアドレス" for="signup-email">
                <KavInput
                  id="signup-email"
                  name="signup-email"
                  type="email"
                  value=""
                  required
                  autocomplete="email"
                />
              </KavField>
              <KavField label="パスワード（12文字以上）" for="signup-password">
                <KavInput
                  id="signup-password"
                  name="signup-password"
                  type="password"
                  value=""
                  required
                  minlength="12"
                  autocomplete="new-password"
                />
              </KavField>
              <KavButton type="submit" color="primary">アカウントを作成</KavButton>
            </form>
          </section>
        </div>
      </KavPage>
    </main>
  </body>
</html>
<script>
  document.querySelectorAll<HTMLFormElement>("main form").forEach((form) => {
    form.addEventListener("submit", (event) => event.preventDefault());
  });
</script>
