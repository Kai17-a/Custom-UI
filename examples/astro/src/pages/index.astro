---
import {ClientRouter} from 'astro:transitions';
import {KavProvider,KavContainer,KavButton,KavCard,KavBanner,KavSelect,KavInput,KavDialog,KavSidebar,KavCalendar,KavChart,KavIcon} from '@kav-ui/astro';
import VueDemo from '../components/VueDemo.vue';
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Kav-UI Astro example</title><ClientRouter/></head><body><KavProvider/><header class="ui-header"><div class="ui-container ui-header-inner"><a class="ui-brand" href="/">Kav-UI / Astro</a><a href="/second" data-testid="astro-next">次のページ</a></div></header>
<KavSidebar id="astro-sidebar" title="Workspace" label="サンプルのナビゲーション"><nav slot="menu" class="app-sidebar-group"><a href="/" aria-current="page"><KavIcon name="mdi-home" class="sidebar-icon"/><span class="sidebar-label">概要</span></a><a href="/second"><KavIcon name="mdi-information-outline" class="sidebar-icon"/><span class="sidebar-label">次のページ</span></a></nav><KavButton color="secondary" variant="outline" icon="mdi-menu" data-ui-toggle="sidebar-responsive" data-ui-target="#astro-sidebar">メニュー</KavButton>
<KavContainer><h1>Astroコンポーネント</h1><KavBanner title="Astro版" closable id="astro-banner">静的HTMLと共通のブラウザ処理を組み合わせます。</KavBanner><KavCard title="設定" class="sp-mt-4"><form><KavInput label="名前" name="name" value="Astro"/><KavSelect label="プラン" name="plan" value="personal" options={[{value:'personal',label:'個人'},{value:'team',label:'チーム'}]}/><KavInput type="date" label="日付" name="date" value="2026-10-23"/></form><KavButton data-ui-toggle="dialog" data-ui-target="#astro-dialog" data-testid="astro-open">モーダルを開く</KavButton></KavCard><KavDialog id="astro-dialog" title="確認"><p>Astro版のモーダルです。</p><KavButton data-ui-dismiss="dialog">閉じる</KavButton></KavDialog><KavCalendar value="2026-10-23" month="2026-10" class="sp-mt-4"/><KavChart config={{type:'bar',labels:['月','火'],series:[{name:'利用者',values:[10,20]}]}}/><VueDemo client:load/></KavContainer></KavSidebar></body></html>
