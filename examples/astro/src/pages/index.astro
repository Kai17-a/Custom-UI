---
import {ClientRouter} from 'astro:transitions';
import {KavStack,KavCluster,KavFlex,KavGrid,KavGridItem,KavPageHeader,KavToolbar,KavSection,KavPage,KavProvider,KavContainer,KavButton,KavCard,KavBanner,KavSelect,KavInput,KavField,KavDialog,KavTabs,KavDrawer,KavSidebar,KavCalendar,KavChart,KavIcon} from '@kav-ui/astro';
import VueDemo from '../components/VueDemo.vue';
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Kav-UI Astro example</title><ClientRouter/></head><body><KavProvider/><header class="ui-header"><div class="ui-container ui-header-inner"><a class="ui-brand" href="/">Kav-UI / Astro</a><a href="/second" data-testid="astro-next">次のページ</a></div></header>
<KavSidebar id="astro-sidebar" title="Workspace" label="サンプルのナビゲーション"><nav slot="menu" class="app-sidebar-group"><a href="/" aria-current="page"><KavIcon name="mdi-home" class="sidebar-icon"/><span class="sidebar-label">概要</span></a><a href="/second"><KavIcon name="mdi-information-outline" class="sidebar-icon"/><span class="sidebar-label">次のページ</span></a></nav><KavButton color="secondary" variant="outline" icon="mdi-menu" data-ui-toggle="sidebar-responsive" data-ui-target="#astro-sidebar">メニュー</KavButton>
<KavContainer><KavSection data-testid="layout-section" title="Layout components"><KavPage asideLabel="Layout navigation" railLabel="Layout details"><p slot="aside">Projects</p><p slot="rail">Updated today</p><KavStack gap={4}>
<KavPageHeader title="Projects" description="Typed props compose the page." eyebrow="Workspace" level={2}><p>Recent projects</p><KavButton slot="actions">New project</KavButton></KavPageHeader>
<KavToolbar label="Project tools"><span>All projects</span><KavCluster slot="end" gap={0} align="start" data-testid="layout-cluster"><KavButton variant="outline">Filter</KavButton></KavCluster></KavToolbar>
<KavGrid cols={{base:3,tablet:2,mobile:1}} gap={3} data-testid="layout-grid">{['Design','Development','Review'].map(title=><KavGridItem><KavCard title={title}><p>Shared layout primitives</p></KavCard></KavGridItem>)}</KavGrid>
<KavFlex direction="row" gap={2} align="center" data-testid="layout-flex"><span class="fx-flex-1 fx-min-0 type-truncate">A growing item with a very long project name that should truncate rather than overflow the available width</span><KavButton class="fx-shrink-0">Open</KavButton></KavFlex>
</KavStack></KavPage></KavSection><h1>Astroコンポーネント</h1><KavBanner title="Astro版" closable id="astro-banner">静的HTMLと共通のブラウザ処理を組み合わせます。</KavBanner><KavCard title="設定" class="sp-mt-4"><form><KavField label="名前" for="astro-name"><KavInput id="astro-name" label="名前" name="name" value="Astro"/></KavField><KavField label="プラン" for="astro-plan"><KavSelect id="astro-plan" label="プラン" name="plan" value="personal" options={[{value:'personal',label:'個人'},{value:'team',label:'チーム'}]}/></KavField><KavField label="日付" for="astro-date"><KavInput id="astro-date" type="date" label="日付" name="date" value="2026-10-23"/></KavField></form><KavButton data-ui-toggle="dialog" data-ui-target="#astro-dialog" data-testid="astro-open">モーダルを開く</KavButton></KavCard><KavDialog id="astro-dialog" title="確認"><p>Astro版のモーダルです。</p><KavButton data-ui-dismiss="dialog">閉じる</KavButton></KavDialog><KavTabs id="astro-tabs" label="プロジェクト" items={[{value:'overview',label:'概要'},{value:'activity',label:'履歴'}]} data-testid="astro-tabs"><p slot="overview">概要の本文</p><p slot="activity">履歴の本文</p></KavTabs><KavButton data-ui-toggle="dialog" data-ui-target="#astro-drawer" data-testid="astro-drawer-open">ドロワーを開く</KavButton><KavDrawer id="astro-drawer" title="プロジェクト設定"><p>ドロワーの本文です。</p><KavButton slot="footer" data-ui-dismiss="dialog">閉じる</KavButton></KavDrawer><KavCalendar value="2026-10-23" month="2026-10" class="sp-mt-4"/><KavChart config={{type:'bar',labels:['月','火'],series:[{name:'利用者',values:[10,20]}]}}/><VueDemo client:load/></KavContainer></KavSidebar></body></html>
