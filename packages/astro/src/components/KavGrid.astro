---
import {gridClass} from '@kav-ui/core';
import type {GridProps} from '@kav-ui/core';
import type {HTMLAttributes} from 'astro/types';
interface Props extends GridProps, Omit<HTMLAttributes<'div'>,keyof GridProps> {[key:`data-${string}`]:unknown;}
const {cols,gap,as:Tag='div',class:className,...rest}=Astro.props;
---
<Tag {...rest} class:list={[gridClass({cols,gap}),className]}><slot/></Tag>
