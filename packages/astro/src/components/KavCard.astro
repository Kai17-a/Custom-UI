---
interface Props {title?:string;description?:string;class?:string;id?:string;}
const {title,description,class:className,...rest}=Astro.props;
---
<section {...rest} class:list={['ui-card',className]}>{Astro.slots.has('header')&&<header class="ui-card-header"><slot name="header"/></header>}<div class="ui-card-body">{title&&<h2 class="ui-card-title">{title}</h2>}{description&&<p class="ui-card-description">{description}</p>}<slot/></div>{Astro.slots.has('footer')&&<footer class="ui-card-footer"><slot name="footer"/></footer>}</section>
