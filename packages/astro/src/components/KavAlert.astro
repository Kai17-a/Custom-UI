---
import {semanticColor} from '@kav-ui/core';
interface Props {color?:string;title?:string;closable?:boolean;class?:string;id?:string;}
const {color='info',title,closable=false,...rest}=Astro.props;
---
<div {...rest} class:list={['alert','alert-'+semanticColor(color),closable&&'alert-dismissible',rest.class]} role="note"><div>{title&&<h3 class="alert-title">{title}</h3>}<slot/></div>{closable&&<button type="button" class="btn-close" data-ui-dismiss="alert" aria-label="案内を閉じる"/>}</div>
<script>import {installAstro} from "../client.js";installAstro();</script>
