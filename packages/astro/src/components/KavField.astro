---
interface Props {label?:string;for?:string;hint?:string;error?:string;class?:string;}
const {label,hint,error,for:target,...rest}=Astro.props;
---
<div {...rest} class:list={['field',rest.class]}>{label&&<label for={target}>{label}</label>}<slot/>{hint&&<small class="dim">{hint}</small>}{error&&<small class="ui-invalid-feedback" role="alert">{error}</small>}</div>
