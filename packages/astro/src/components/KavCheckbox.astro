---
import type {HTMLAttributes} from 'astro/types';
interface Props extends HTMLAttributes<'input'> {label?:string;}
const {label,class:className,...rest}=Astro.props;
---
<label class="form-check"><input {...rest} type="checkbox" class:list={['form-check-input',className]}/><span class="form-check-label">{label}<slot/></span></label>
