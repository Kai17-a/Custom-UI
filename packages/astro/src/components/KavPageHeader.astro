---
import {headingTag} from '@kav-ui/core';
import type {PageHeaderProps} from '@kav-ui/core';
import type {HTMLAttributes} from 'astro/types';
interface Props extends PageHeaderProps, Omit<HTMLAttributes<'div'>,keyof PageHeaderProps> {[key:`data-${string}`]:unknown;}
const {title,description,eyebrow,level=1,class:className,...rest}=Astro.props;
const Heading=headingTag(level);
---
<header {...rest} class:list={['ui-page-header',className]}><div class="ui-page-heading">{eyebrow&&<p class="ui-page-eyebrow">{eyebrow}</p>}{title&&<Heading class="ui-page-title">{title}</Heading>}{description&&<p class="ui-page-description">{description}</p>}<slot/></div>{Astro.slots.has('actions')&&<div class="ui-page-actions"><slot name="actions"/></div>}</header>
