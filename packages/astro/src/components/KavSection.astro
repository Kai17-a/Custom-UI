---
import {headingTag} from '@kav-ui/core';
import type {SectionProps} from '@kav-ui/core';
import type {HTMLAttributes} from 'astro/types';
interface Props extends SectionProps, Omit<HTMLAttributes<'div'>,keyof SectionProps> {[key:`data-${string}`]:unknown;}
const {title,description,level=2,class:className,...rest}=Astro.props;
const Heading=headingTag(level,2);
---
<section {...rest} class:list={['ui-section',className]}>{(title||description||Astro.slots.has('actions'))&&<header class="ui-section-header"><div>{title&&<Heading class="ui-section-title">{title}</Heading>}{description&&<p class="ui-section-description">{description}</p>}</div><slot name="actions"/></header>}<slot/></section>
