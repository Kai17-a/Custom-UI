---
import type {HTMLAttributes} from 'astro/types';
interface Props extends HTMLAttributes<'input'> {label?:string;}
const {label,...rest}=Astro.props;
---
<label class="form-check"><input {...rest} type="radio" class:list={['form-check-input',rest.class]}/><span class="form-check-label">{label}<slot/></span></label>
